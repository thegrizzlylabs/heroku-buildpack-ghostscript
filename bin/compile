#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir>

set -e

echo "-----> Installing Ghostscript 10.08.0"

BUILD_DIR=$1
PACKAGE="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10080/ghostscript-10.08.0.tar.gz"
LOCATION="$BUILD_DIR/vendor/gs"

mkdir -p $LOCATION /tmp/gs-source
curl $PACKAGE -L -s -f -o - | tar xzf - -C /tmp/gs-source --strip-components=1

# Heroku runs the app from /app, so the prefix must be /app/vendor/gs
# even though the files are staged and then copied into the build dir.
cd /tmp/gs-source
./configure --prefix=/app/vendor/gs --without-x --disable-cups > /dev/null
make -j"$(nproc)" > /dev/null
make install DESTDIR=/tmp/gs-stage > /dev/null
cp -a /tmp/gs-stage/app/vendor/gs/. $LOCATION

echo "-----> Building runtime environment for Ghostscript"

mkdir -p $BUILD_DIR/.profile.d
echo "export PATH=\"\$HOME/vendor/gs/bin:\$PATH\"" > $BUILD_DIR/.profile.d/ghostscript.sh
